{
    "name":"cbsecurity-boxlang-cfml@1",
    "app":{
        "serverHomeDirectory":".engine/boxlang-cfml",
        "cfengine":"boxlang@1"
    },
    "web":{
        "host":"0.0.0.0",
        "http":{
            "port":"60299"
        },
        "rewrites":{
            "enable":true
        },
        "webroot":"test-harness",
        "aliases":{
            "/moduleroot/cbsecurity":"../"
        }
    },
    "JVM":{
        "heapSize":"1024",
        "javaVersion":"openjdk21_jre",
        "args":"-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=7777"
    },
    "openBrowser":false,
    "cfconfig":{
        "file":".cfconfig.json"
    },
    "env":{},
    "scripts":{
        "onServerInitialInstall":"install bx-compat-cfml,bx-esapi,bx-mysql --noSave"
    }
}
